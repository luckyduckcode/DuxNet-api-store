# DuxNet Production Configuration
# Copy this to .env and modify values for your production environment

# === DuxCoin RPC Configuration ===
DUXCOIN_RPC_URL=http://localhost:8332
DUXCOIN_RPC_USER=duxnetuser
DUXCOIN_RPC_PASSWORD=change_this_password_in_production
DUXCOIN_WALLET_PASSPHRASE=change_this_passphrase_in_production

# === Server Configuration ===
DUXNET_PORT=8081
DUXNET_HOST=0.0.0.0
DUXNET_ENV=production

# === Security Configuration ===
API_KEY_SALT=change_this_salt_in_production
JWT_SECRET=change_this_jwt_secret_in_production
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# === Database Configuration (if using external DB) ===
DATABASE_URL=postgresql://username:password@localhost/duxnet
REDIS_URL=redis://localhost:6379

# === P2P Network Configuration ===
P2P_PORT=9000
P2P_BOOTSTRAP_NODES=
DHT_REPLICATION_FACTOR=3

# === Logging Configuration ===
RUST_LOG=info,duxnet=debug
LOG_FILE=/var/log/duxnet/duxnet.log

# === Rate Limiting ===
DEFAULT_RATE_LIMIT=1000
DEFAULT_WINDOW_SECONDS=3600
BURST_RATE_LIMIT=100

# === Community Fund ===
COMMUNITY_TAX_RATE=0.02
DISTRIBUTION_INTERVAL=43200

# === SSL/TLS Configuration ===
TLS_CERT_PATH=/etc/ssl/certs/duxnet.crt
TLS_KEY_PATH=/etc/ssl/private/duxnet.key

# === Monitoring ===
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# === Backup Configuration ===
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600
BACKUP_DIRECTORY=/var/backups/duxnet
